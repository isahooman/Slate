{
  "name": "slate",
  "version": "4.12",
  "description": "A Discord.js Bot Startup Codebase",
  "keywords": [
    "node",
    "discord",
    "discord.js"
  ],
  "homepage": "https://github.com/isahooman/slate#readme",
  "scripts": {
    "start": "cross-os start-os",
    "start-os": {
      "darwin": "bash start.sh",
      "linux": "bash start.sh",
      "win32": "start.bat"
    },
    "prestart": "npm install cross-os"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cross-os": "^1.5.0",
    "discord.js": "^14.11.0",
    "json5": "^2.2.3",
    "mathjs": "^14.4.0",
    "node-os-utils": "^1.3.7"
  },
  "devDependencies": {
    "eslint": "^9.23.0",
    "eslint-plugin-jsdoc": "^48.0.6"
  },
  "engines": {
    "node": ">=16.20.2",
    "npm": ">=8.19.4"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "imports": {
    "#root/*": "./*",
    "#components/*": "./bot/components/*",
    "#bot": "./bot/bot.js"
  }
}